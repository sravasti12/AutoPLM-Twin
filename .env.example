MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=autoplm_twin
OPENAI_API_KEY=
AUTOPLM_LLM_MODEL=
# Optional OpenAI-compatible endpoint
AUTOPLM_LLM_BASE_URL=
AUTOPLM_API_URL=http://localhost:8000
AUTOPLM_TEST_MONGODB_URI=

# local uses the separate static registry. production/staging require verified
# OIDC metadata/JWKS, authenticated TLS MongoDB and initialized shared security state.
# Never use local mode on a public backend to avoid the production checks.
AUTOPLM_ENVIRONMENT=local
# Inject AUTOPLM_REVIEW_CREDENTIALS through a protected process environment;
# do not store tokens or a populated credential registry in this example.

# Required for production/staging, matching Streamlit's protected OIDC settings.
AUTOPLM_OIDC_ISSUER=
AUTOPLM_OIDC_AUDIENCE=
AUTOPLM_OIDC_CLIENT_ID=
# Live provider execution remains opt-in; budgets still apply when enabled.
AUTOPLM_ENABLE_LLM=false
# Trusted operator CLI only: separate privileged database credential, never the API environment.
AUTOPLM_PROVISIONING_MONGODB_URI=
