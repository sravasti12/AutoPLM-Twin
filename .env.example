MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=autoplm_twin
OPENAI_API_KEY=
AUTOPLM_LLM_MODEL=
# Optional OpenAI-compatible endpoint
AUTOPLM_LLM_BASE_URL=
AUTOPLM_API_URL=http://localhost:8000
AUTOPLM_TEST_MONGODB_URI=

# Local-only identity boundary. Any other value blocks API startup until a
# production identity provider is implemented. Never use local mode in production.
AUTOPLM_ENVIRONMENT=local
# Inject AUTOPLM_REVIEW_CREDENTIALS through a protected process environment;
# do not store tokens or a populated credential registry in this example.
